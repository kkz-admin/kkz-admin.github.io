---
import type { BlogPost } from "../lib/posts";
import { archivePath, BLOG_CATEGORIES, categoryPath } from "../lib/blog-paths";
import { withBase } from "../lib/url";
import ArticleCard from "./ArticleCard.astro";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const categories = [
  { label: "全部", path: "/blog/" },
  ...BLOG_CATEGORIES.map(({ label, slug }) => ({
    label,
    path: categoryPath(slug),
  })),
];
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const archive = Object.entries(
  posts.reduce<Record<string, number>>((years, post) => {
    const year = String(post.data.publishedAt.getFullYear());
    years[year] = (years[year] ?? 0) + 1;
    return years;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<div class="blog-tools" data-blog-tools>
  <label
    >搜索文章<input
      type="search"
      aria-label="搜索文章"
      data-blog-search
    /></label
  >
  <div role="group" aria-label="文章分类">
    {
      categories.map((category) => (
        <a
          href={withBase(category.path)}
          data-category-button={category.label}
          data-active={category.label === "全部" ? "true" : "false"}
          aria-current={category.label === "全部" ? "page" : undefined}
        >
          {category.label}
        </a>
      ))
    }
  </div>
  <div role="group" aria-label="文章标签">
    {
      tags.map((tag) => (
        <button type="button" data-tag-button={tag}>
          #{tag}
        </button>
      ))
    }
  </div>
</div>
<aside class="archive" aria-label="文章归档">
  <strong>归档</strong>
  {
    archive.map(([year, count]) => (
      <a href={withBase(archivePath(year))}>
        {year} · {count} 篇
      </a>
    ))
  }
</aside>
<noscript>
  <div class="static-browse">
    <h2>静态浏览</h2>
    <section>
      <h3>按分类</h3>
      {
        BLOG_CATEGORIES.map(({ label, slug }) => (
          <div>
            <h4>
              <a href={withBase(categoryPath(slug))}>{label}</a>
            </h4>
            <ul>
              {posts
                .filter((post) => post.data.category === label)
                .map((post) => (
                  <li>
                    <a href={withBase(`/blog/${post.id}/`)}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>
    <section>
      <h3>按年份</h3>
      {
        archive.map(([year]) => (
          <div>
            <h4>
              <a href={withBase(archivePath(year))}>{year}</a>
            </h4>
            <ul>
              {posts
                .filter(
                  (post) =>
                    String(post.data.publishedAt.getFullYear()) === year,
                )
                .map((post) => (
                  <li>
                    <a href={withBase(`/blog/${post.id}/`)}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</noscript>
<p class="empty" data-empty hidden>没有找到匹配的文章。</p>
<div class="blog-grid" data-blog-grid>
  {posts.map((post) => <ArticleCard post={post} />)}
</div>

<script>
  import { initBlogFilter } from "../scripts/blog-filter";

  initBlogFilter(document);
</script>

<style>
  .blog-tools {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  label {
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
  }
  input {
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 1rem;
    background: #0b0b0b;
    color: var(--text);
  }
  [role="group"] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  button,
  [data-category-button] {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    text-decoration: none;
  }
  [data-active="true"] {
    color: #050505;
    background: var(--text);
  }
  .blog-grid {
    display: grid;
    gap: 1rem;
  }
  .archive {
    display: flex;
    gap: 1rem;
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .archive a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .static-browse {
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
  }
  .static-browse section,
  .static-browse ul {
    display: grid;
    gap: 0.75rem;
  }
  .empty {
    color: var(--muted);
  }
</style>
